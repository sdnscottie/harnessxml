<!-- HX-3501: a literal API key in the document. These files are committed to
     git, diffed in pull requests and archived for audit — three excellent ways
     to publish a key. Layer 2: not catchable by the schema. -->
<harness xmlns="https://harnessxml.com/spec/1.0" id="leaky" specVersion="1.0">
  <resources>
    <resource id="m" type="model" provider="anthropic">
      <property name="apiKey" value="sk-ant-api03-QmFkSWRlYVRoaXNJc0FGYWtlS2V5Rm9yVGVzdGluZw"/>
    </resource>
  </resources>
  <nodes>
    <node id="a" type="inference">
      <resourceRef ref="m" role="model"/>
    </node>
  </nodes>
</harness>
